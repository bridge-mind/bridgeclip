{
  "name": "bridgeclip",
  "productName": "BridgeClip",
  "version": "0.1.16",
  "description": "BridgeClip: open-source AI video clipping by BridgeMind. Turn long videos into captioned short-form clips, locally, with your own API keys.",
  "main": "./out/main/index.js",
  "author": "BridgeMind",
  "license": "MIT",
  "homepage": "https://github.com/bridge-mind/bridgeclip",
  "repository": {
    "type": "git",
    "url": "https://github.com/bridge-mind/bridgeclip.git"
  },
  "bugs": {
    "url": "https://github.com/bridge-mind/bridgeclip/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac --$(node -p 'process.arch')",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac-arm64": "electron-vite build && electron-builder --mac --arm64",
    "dist:mac-x64": "electron-vite build && electron-builder --mac --x64",
    "dist:win-x64": "electron-vite build && electron-builder --win --x64",
    "lint": "eslint .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "icons": "bash scripts/icon/build-icons.sh",
    "test:bridge": "node scripts/run-bridge-tests.cjs",
    "test:release": "node --test scripts/*.test.cjs",
    "test:renderer": "node --test tests/renderer-state.test.cjs tests/create-form.test.cjs",
    "test:main": "node --test tests/main/*.test.cjs",
    "test:zernio": "node --test tests/zernio/*.test.cjs",
    "test:e2e": "node --test --test-concurrency=1 tests/main/local-file.e2e.cjs tests/zernio/e2e/accounts.e2e.cjs tests/zernio/e2e/automations.e2e.cjs tests/zernio/posts.e2e.cjs",
    "test": "npm run test:main && npm run test:renderer && npm run test:zernio && npm run test:bridge && npm run test:release"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "electron-updater": "^6.8.9",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "js-yaml": "^5.4.2",
    "lucide-react": "^0.468.0",
    "playwright-core": "1.63.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "zustand": "^5.0.15"
  }
}
